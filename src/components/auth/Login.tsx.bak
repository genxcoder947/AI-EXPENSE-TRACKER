import React, { useState } from 'react';
import { Input } from '../ui/input';
import { Button } from '../ui/button';
import { Label } from '../ui/label';
import { Card } from '../ui/card';

type LoginProps = {
  onLogin: (username: string, password: string) => void;
};

export default function Login({ onLogin }: LoginProps) {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    setLoading(true);

    // Simple validation
    if (!email.includes('@') || !email) {
      setError('Please enter a valid email');
      setLoading(false);
      return;
    }

    if (password.length < 6) {
      setError('Password must be at least 6 characters');
      setLoading(false);
      return;
    }

    // Attempt to login via the provided onLogin function (from auth system)
    onLogin(email, password);
    // Note: The onLogin function will set the user state in App via setUser.
    // We don't handle the result here because the auth system sets the currentUser.
    // However, we can check if the login was successful by seeing if the user is set?
    // But we don't have access to the user state here. We'll rely on the auth system.
    // We'll reset loading and let the App component rerender when user is set.
    // We'll set a timeout to reset loading in case of failure? Actually, we don't know.
    // We'll leave it to the App to handle errors (we showed an alert in App's handleLogin).
    setLoading(false);
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-emerald-50 to-emerald-300 dark:from-slate-900 dark:to-slate-800 flex items-center justify-center p-4">
      <Card className="w-full max-w-md p-8 space-y-6">
        <div className="text-center">
          <h1 className="text-2xl font-bold text-slate-800 dark:text-slate-100">
            Welcome to ExpenseAI
          </h1>
          <p className="text-slate-600 dark:text-slate-400">
            Please sign in to continue
          </p>
        </div>
        <form onSubmit={handleSubmit} className="space-y-4">
          <div>
            <Label htmlFor="email">Email</Label>
            <Input
              type="email"
              id="email"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              placeholder="Enter your email"
              className="w-full"
              disabled={loading}
            />
          </div>
          <div>
            <Label htmlFor="password">Password</Label>
            <Input
              type="password"
              id="password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              placeholder="Enter your password"
              className="w-full"
              disabled={loading}
            />
          </div>
          {error && (
            <p className="text-sm text-red-600 dark:text-red-400">{error}</p>
          )}
          <Button type="submit" className="w-full" disabled={loading}>
            {loading ? 'Signing in...' : 'Sign In'}
          </Button>
        </form>
        <div className="text-center text-sm text-slate-500 dark:text-slate-400">
          <p>
            Don't have an account? <span className="text-emerald-600 dark:text-emerald-400 hover:underline">
              Sign up
            </span>
          </p>
        </div>
      </Card>
    </div>
  );
}
